# =============================================================================
# Huly V7 PG — Environment Configuration (PostgreSQL variant)
# =============================================================================
# Copy this file to .env and fill in the required values.
# Works with Coolify (Git repo deployment), Portainer, or bare docker compose.
#
# This is the PostgreSQL variant of huly-v7-next. Same 40 services, but uses
# PostgreSQL 17 instead of CockroachDB — saving ~1-1.5GB RAM at idle.
#
# Secrets: Generate with the commands shown below, or use your own values.
# =============================================================================

# --- Huly Version (pinned upstream Docker image tag) ---
HULY_VERSION=v0.7.382

# --- Domain (REQUIRED) ---
# Your Huly domain, e.g. huly.example.com
# Must have a DNS A record pointing to your server's IP
HOST_ADDRESS=huly.example.com

# --- Secrets (REQUIRED — generate before first deploy) ---
# openssl rand -base64 64 | tr -d '\n'
SECRET=

# PostgreSQL password (openssl rand -base64 24 | tr -d '/+=' | head -c 32)
PG_PASSWORD=

# Redpanda admin password (openssl rand -base64 24 | tr -d '/+=' | head -c 16)
REDPANDA_ADMIN_PWD=

# LiveKit API key (openssl rand -base64 24 | tr -d '/+=' | head -c 16)
LIVEKIT_API_KEY=

# LiveKit API secret (openssl rand -base64 32 | tr -d '\n')
LIVEKIT_API_SECRET=

# AI bot account password (openssl rand -base64 24 | tr -d '/+=' | head -c 32)
# The bot account (huly.ai.bot@hc.engineering) is reachable via the public login
# endpoint — if left empty this falls back to the well-known default 'password'.
AI_BOT_PASSWORD=

# --- Database ---
PG_DATABASE=huly
PG_USERNAME=huly
# Constructed from PG_PASSWORD above — update the password portion if you change PG_PASSWORD
PG_DB_URL=postgres://huly:CHANGE_ME@postgres:5432/huly

# --- Storage ---
STORAGE_CONFIG=datalake|http://datalake:4031

# --- S3 / MinIO Object Storage ---
# Bundled MinIO: generate unique credentials BEFORE first deploy — these become the
# MinIO root user/password and are used by all services. If left empty, the stack
# falls back to minioadmin/minioadmin (not recommended).
#   S3_ACCESS_KEY: openssl rand -base64 24 | tr -d '/+=' | head -c 16
#   S3_SECRET_KEY: openssl rand -base64 24 | tr -d '/+=' | head -c 32
# External S3 (AWS, Backblaze B2, Cloudflare R2, DigitalOcean Spaces): set all four
# values and pre-create buckets: blobs, eu, backups. Optionally disable the minio service.
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

# --- Redpanda ---
REDPANDA_ADMIN_USER=admin

# --- UI Customization ---
TITLE=Huly
DEFAULT_LANGUAGE=en
LAST_NAME_FIRST=true

# --- Platform Admin ---
# Comma-separated list of admin email addresses
PLATFORM_ADMIN_EMAILS=

# --- Disable Sign-Up ---
# Set to true AFTER creating your first user to prevent public registrations
DISABLE_SIGNUP=false

# --- Sample Data ---
# Default: new workspaces are empty (no demo projects/issues/Card types).
# To seed new workspaces with sample content, set to: ./init-scripts
INIT_REPO_DIR=/nonexistent

# --- Email / SMTP (REQUIRED for OTP login) ---
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# --- Amazon SES (alternative to SMTP — leave blank if using SMTP) ---
SES_ACCESS_KEY=
SES_SECRET_KEY=
SES_REGION=

# --- AI Assistant (optional — requires OPENAI_API_KEY for AI features) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
OPENAI_SUMMARY_MODEL=
OPENAI_TRANSLATE_MODEL=
AI_BOT_FIRST_NAME=Huly
AI_BOT_LAST_NAME=AI

# --- LiveKit Configuration (built-in — keys set above) ---
# No additional LiveKit config needed. Keys are auto-injected into livekit.yaml
# at container startup via the entrypoint script.

# --- Speech-to-Text for Meeting Transcription (optional — used by love-agent) ---
# STT_PROVIDER: 'deepgram' (default) or 'openai' (uses Realtime API, not Whisper)
STT_PROVIDER=deepgram
# For Deepgram: set DEEPGRAM_API_KEY (default model: nova-3)
DEEPGRAM_API_KEY=
# For OpenAI: uses OPENAI_API_KEY from above (default model: gpt-4o-transcribe)
# OPENAI_PROVIDE_LANGUAGE: 'true' (default) sends language hint to OpenAI STT,
# 'false' disables hint and lets OpenAI auto-detect (better for multilingual meetings)
OPENAI_PROVIDE_LANGUAGE=true
LOVE_AGENT_DEBUG=false

# --- Google Calendar & Gmail Integration (optional) ---
# JSON credentials from Google Cloud Console OAuth 2.0
GOOGLE_CREDENTIALS=

# --- Telegram Bot Integration (optional) ---
# Get token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# --- GitHub Integration (optional — requires GitHub App) ---
GITHUB_APPID=
GITHUB_APPNAME=
GITHUB_CLIENTID=
GITHUB_CLIENT_SECRET=
GITHUB_PRIVATE_KEY=
GITHUB_BOT_NAME=

# --- Meeting-minutes counter reconciliation (workaround for upstream bug) ---
# Interval in seconds between reconciliation runs
RECONCILE_INTERVAL=300

# --- Push Notifications (optional — requires VAPID keys) ---
# Generate: npx web-push generate-vapid-keys
# Without keys, push notifications are disabled. Everything else works normally.
PUSH_PUBLIC_KEY=
PUSH_PRIVATE_KEY=
PUSH_SUBJECT=mailto:noreply@example.com

# --- PDF Digital Signature (optional) ---
# Self-signed cert auto-generated on first start. See README for production cert setup.
# Set a random password BEFORE first deploy (openssl rand -base64 12). If left empty
# it falls back to 'password'. Changing it later requires deleting the sign_cert volume
# so the cert is regenerated.
SIGN_CERTIFICATE_PASSWORD=
